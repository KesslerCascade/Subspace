{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/../build/${presetName}"
        },
        {
            "name": "game-win32",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "$env{VSCMD_ARG_TGT_ARCH}",
                "rhs": "x86"
            },
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;MinSizeRel",
                "BUILD_GAME": true,
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "game-debug",
            "displayName": "Game (Debug)",
            "configurePreset": "game-win32",
            "configuration": "Debug"
        },
        {
            "name": "game-dev-release",
            "displayName": "Game (Dev Release)",
            "configurePreset": "game-win32",
            "configuration": "MinSizeRel"
        },
        {
            "name": "game-release",
            "displayName": "Game (Release)",
            "configurePreset": "game-win32",
            "configuration": "Release"
        }
    ]
}
