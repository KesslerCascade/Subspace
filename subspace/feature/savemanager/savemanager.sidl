#include <cx/taskqueue.sidl>
#include "feature/feature.sidl"

class RunInfo;
class SaveManager extends SubspaceFeature {
    factory create(Subspace* ss);
    override createSettingsPage;
    override applyDefaultSettings;

    bool autoSave(RunInfo* run, strref fname);
}

class SaveManagerCopy extends ComplexTask {
    object:SaveManager smgr;
    object:RunInfo run;
    int64 runid;
    int64 savepoint;
    int64 timestamp;
    string fname;
    string destfn;

    factory create(SaveManager* smgr, RunInfo* run, strref fname, strref destfn, int64 runid, int64 savepoint, int64 timestamp);
}