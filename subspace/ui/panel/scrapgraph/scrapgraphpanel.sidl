#include "ui/panel/panel.sidl"
#include "run/logrelay.sidl"

typedef struct ScrapData {
    int sectorpoint;
    int amount;
} ScrapData;
saDeclare(ScrapData);

class ScrapGraphPanel extends Panel implements LogSubscriber {
    Ihandle *plot;
    int ds;
    int si;

    Mutex lock;
    bool reset;
    bool redraw;
    [noinit] sarray:ScrapData newscrap;
    [noinit] sarray:ScrapData sdata;

    void clear();

    factory create(SubspaceUI *ui);
    override make;
    override update;
}