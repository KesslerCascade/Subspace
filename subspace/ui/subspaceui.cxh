#include <cx/taskqueue.cxh>
#include "subspace.h"
#include "lang/lang.h"

typedef void (*uiNotifyCallback)(void *self, strref event, stvlist *params);

#define ssuiNotify(self, event, ...) SubspaceUI__notify(self, event, count_macro_args(__VA_ARGS__), (stvar[]){ __VA_ARGS__ })

class MainWin;
class SettingsWin;
class RunHistoryWin;
[methodprefix ssui] class SubspaceUI {
    Subspace *ss;
    object:TaskQueue uiq;
    bool started;

    object:MainWin mainw;
    object:SettingsWin settingsw;
    object:RunHistoryWin runhistw;

    RWLock listenerlock;
    hashtable:string:sarray listeners;

    factory create(Subspace *subspace);
    bool initialize();
    bool shutdown();

    void start();
    void stop();

    void update();
    void updateMain(strref panel);
    void updateSettings(strref page);

    bool listen(ObjInst* listener, uiNotifyCallback func, strref event);
    unbound void _notify(strref event, int n, stvar params[]);
}

class UINotifyDispatch extends ComplexTask
{
    object:SubspaceUI ui;
    string event;
    [noinit] sarray:stvar params;
    factory create(SubspaceUI* ui, strref event, int n, stvar params[]);
}
