#include "subspace.h"
#include <cx/fs/vfsobj.cxh>
#include <cx/taskqueue.cxh>

typedef enum GameDataState {
    GD_Init,
    GD_Loading,
    GD_Available,
    GD_Error
} GameDataState;

class GameData {
    object:VFS ftldat;
    RWLock lock;

    GameDataState _state;
    object:TRGate loaded;
    hashtable:string:string text;       // language translations

    factory create();
    bool load(Subspace* ss, VFS* parentvfs, strref ftldir);
    GameDataState state();
    void wait(ComplexTask *task);   // make a task wait for data
    strref getText(strref key);
    strref getTextD(strref key, strref def);
}

class GameDataLoader extends ComplexTask {
    Subspace* ss;
    object:GameData data;

    factory create(Subspace* ss, GameData *data);
}