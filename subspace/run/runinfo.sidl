#include "subspace.h"
#include "gamedata/gamedata.sidl"
#include "sectorinfo.sidl"
#include "logentspec.h"
#include <cx/taskqueue.sidl>

// Do NOT change the ordering of these; the values are saved in the database as-is!
typedef enum {
    RUN_Active = 0,
    RUN_Victory = 1,
    RUN_Defeat = 2,
    RUN_Abandoned = 3
} RunResult;

// Sectorpoint is 256 * [sector number] + extra
// Savepoint is 256 * [beacon number] + extra
// Where extra is the number of extra sectors or beacons there are.
// For sectors going to a secret sector increments extra.
// For beacons, waiting on the same beacon increments extra.

#define SPOINT(num, extra) ((((int64)(num)) << 8) | ((extra) & 0xff))
#define SPOINT_NUM(spoint) (int32)(((spoint) >> 8))
#define SPOINT_EXTRA(spoint) ((int32)((spoint) & 0xff))

class ScrapTracker;
class HullTracker;

class LogEnt;
class RunInfo {
    Subspace *ss;
    RWLock lock;

    int64 runid;        // -1 if not tracked
    int32 seed;
    string shipType;
    string shipName;
    int32 difficulty;
    RunResult result;

    int64 startTime;
    int64 endTime;

    int64 savepoint;
    int64 sectorpoint;

    int32 shipsDefeated;
    int32 beaconsExplored;
    int32 scrapCollected;
    int32 crewHired;
    int32 scrapActual;
    int32 damageTaken;

    bool updatedBeaconShip;

    int64 modified;

    string savePath;

    [sorted] sarray:object:SectorInfo sectors;

    bool recording;     // is this run being currently recorded (i.e. not a historical run)
    bool focused;       // is focused by the UI

    // Trackers
    object:HullTracker hull;
    object:ScrapTracker scrap;

    factory create(Subspace *ss);
    void newGame(int seed, strref shipType, strref shipName, int difficulty);
    void loadGame(int seed, strref shipType, strref shipName, int difficulty, int beacons);

    bool loadHistoric(int64 runid);
    void replayLog(bool combat, int64 savepoint, int64 sectorpoint);

    void enterSector(int num, int seed, strref type, bool secret);
    void updateStats(int ships, int beacons, int scrap, int crew);
    void runLog(int sector, int beacons, int64 time, float64 gametime, strref id, stvar params[LOG_MAX_PARAMS]);
    void beacon(int sector, int beacons, int visit, int x, int y, int64 time, strref event);
    void processLog(LogEnt* ent);
    void processScrap(strref src, int amount, int rawamount);
    void processHullDamage(strref src, int amount);
    void processShip(strref name);

    void setFocused(bool focused);
    bool isFocused();
    bool isRecording();
    
    SectorInfo *getSector(int64 sectorpoint);
    HullTracker *getHull();
    ScrapTracker *getScrap();

    int32 score();

    void finish(RunResult result);
}

class LogReplay extends ComplexTask
{
    Subspace *ss;
    object:RunInfo run;
    bool combat;
    int64 savepoint;
    int64 sectorpoint;

    factory create(Subspace *ss, RunInfo *run, bool combat, int64 savepoint, int64 sectorpoint);
}