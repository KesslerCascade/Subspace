#include <cx/taskqueue.cxh>
#include "subspace.h"
#include "logent.cxh"

interface LogSubscriber {
    void logNotify(LogEnt* ent, bool replay);
    void logReset();
    void logReplayComplete();
}

class SubscriberInfo implements Sortable implements Hashable {
    weak:ObjInst subscriber;
    bool ui;
    factory create(ObjInst* subscriber, bool ui);
}

class RunInfo;
class LogRelay
{
    Subspace *ss;
    object:TRFifo replayqueue;
    RWLock lock;

    hashtable:string:sarray logsubs;
    hashtable:object:none subscribers;

    bool subscribe(ObjInst* subscriber, strref id);
    bool subscribeUI(ObjInst* subscriber, strref id);
    void reset();
    void replayComplete();
    bool send(LogEnt* ent, bool replay);

    factory create(Subspace *ss);
}

class LogDispatch extends ComplexTask
{
    object:ObjInst subscriber;
    object:LogEnt ent;
    bool replay;
    bool reset;
    bool complete;
    factory create(ObjInst *subscriber, LogEnt *ent, bool replay);
    factory createReplay(ObjInst *subscriber, bool reset, bool complete);
}